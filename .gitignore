## Ignore Visual Studio temporary files, build results, and files generated by popular IDEs.
# User-specific files
*.rsuser
*.suo
*.user
*.userndb
*.docstates
# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs
# Mono auto-generated files
mono_crash.*
# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Re]leasePublic/
x64/
x86/
build/
bld/
[Bin]/
[Obj]/
bin/
obj/
Generated Files/
My Project/
[Tt]emp/
# MSBuild Visual Studio cache
.vs/
# Visual Studio Code
.vscode/
# Rider
.idea/
# Publish output
publish/
# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/packages/*
# except build/, which is used as an MSBuild target.
!**/packages/build/
# Uncomment if necessary to exclude NuGet packages from tracking
#globalpackages/
# AppSettings secrets / environment-specific files
appsettings.json.user
# EF Core migrations bundle output
*.exe
# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
